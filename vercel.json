{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm install",
  "buildCommand": "npx prisma generate --schema apps/api/prisma/schema.prisma && npm run build --workspace @autosolve/api && npm run build --workspace @autosolve/web",
  "outputDirectory": "apps/web/dist",
  "framework": null,
  "functions": {
    "api/[...path].js": {
      "maxDuration": 30,
      "includeFiles": "{apps/api/dist/**,node_modules/.prisma/client/**}"
    }
  },
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ]
}
