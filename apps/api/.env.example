# PostgreSQL. En local ambas apuntan a la misma base; en producción con un
# pooler (Neon, Supabase) DATABASE_URL va al pooler y DIRECT_URL a la
# conexión directa, que es la que usan las migraciones.
DATABASE_URL="postgresql://autosolve:autosolve@localhost:5432/autosolve?schema=public"
DIRECT_URL="postgresql://autosolve:autosolve@localhost:5432/autosolve?schema=public"

# Autenticación
JWT_SECRET="cambia-esto-en-produccion"
JWT_EXPIRES_IN="7d"

# Servidor
PORT=3000
CORS_ORIGIN="http://localhost:5173"
