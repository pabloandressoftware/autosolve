# Copia este archivo a .env antes de levantar docker compose.

POSTGRES_USER=autosolve
POSTGRES_PASSWORD=cambia-esta-contraseña
POSTGRES_DB=autosolve

# Obligatorio. Genera uno con: openssl rand -base64 32
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Debe apuntar al origen desde el que se sirve la web.
CORS_ORIGIN=http://localhost:8080

API_PORT=3000
WEB_PORT=8080
