{
  "name": "autosolve",
  "version": "0.1.0",
  "private": true,
  "description": "AutoSolve — diagnóstico, agendamiento y seguimiento de servicios automotrices",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "format": "prettier --write \"apps/**/src/**/*.{ts,tsx,json}\"",
    "format:check": "prettier --check \"apps/**/src/**/*.{ts,tsx,json}\""
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "prettier": "^3.3.3"
  },
  "engines": {
    "node": ">=20"
  }
}
